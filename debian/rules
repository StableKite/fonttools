#!/usr/bin/make -f

include /usr/share/quilt/quilt.make

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

PYVERS=$(shell pyversions -r debian/control)

CFLAGS=-Wall -g

build: patch build-stamp
build-stamp:
	dh_testdir
	set -e ; for python in $(PYVERS); do CFLAGS="$(CFLAGS)" $$python setup.py build; done
	cp Doc/changes.txt build/NEWS
	sed -f debian/stripinstall < Doc/install.txt > build/README
	touch build-stamp

clean: unpatch
	dh_testdir
	dh_testroot
	rm -f build-stamp
	rm -rf build
	dh_clean

install: build
	dh_testdir
	dh_testroot
	dh_clean -k
	dh_installdirs
	set -e ; for python in $(PYVERS); do $$python setup.py install --no-compile --root=debian/fonttools; done
	chmod a+x $(CURDIR)/debian/fonttools/usr/lib/python*/site-packages/FontTools/fontTools/ttx.py

binary-indep: build install
binary-arch: build install
	dh_testdir
	dh_testroot
	dh_installdocs
	dh_installexamples
	dh_installman
	dh_installchangelogs Doc/ChangeLog.txt
	dh_pycentral
	dh_python
	dh_strip
	dh_compress
	dh_fixperms
	dh_installdeb
	dh_shlibdeps
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary install
